@inject IJSRuntime JS
@using Domain.Games;
@inject GameRegistry gameRegistry

@page "/game-screen"

<PageTitle>Game Screen</PageTitle>


@if (game == null)
{
    <div>
        <button class="btn btn-primary" disabled="@hostedGame" @onclick="HostGame">Host Game</button>
        <br /><br />
        <InputText @bind-Value="pinInput" placeholder="Enter game pin" />
        <button class="btn btn-primary" @onclick="JoinGame">Join Game</button>
    </div>
}
else
{
    <div>
        <h2>Lobby ID: @game.Pin</h2>
        <p>Players in Lobby:</p>
        <ul>
            @foreach (var player in game.Players)
            {
                <li style="color: @player.Color">
                    @player.Name
                </li>
            }
        </ul>
    </div>
    <InputText @bind-Value="inputName" placeholder="Enter your name" />
    <button class="btn btn-primary" @onclick="() => JoinPlayer()">Join Lobby</button>
    <br />
    @if (hostedGame)
    {
        <button class="btn btn-primary" @onclick="StartGame">Start Game</button>
        <br />
    }
    <br />
    <button class="btn btn-primary" @onclick="LeaveGame">Leave Game</button>

    <div @ref="gameContainer" class="game-container">

        <button class="btn btn-primary fullscreen-button"
                @onclick="ToggleFullscreen">
            ⛶ Fullscreen
        </button>

        <GameDisplay @ref="gameDisplay" />
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info" role="alert">
        @message
    </div>
}

@code {
    private ElementReference gameContainer;
    private GameDisplay? gameDisplay;

    Game? game;
    Player? player;

    string pinInput = "0000";

    bool playerJoined = false;
    bool hostedGame = false;

    string inputName = string.Empty;

    string message = string.Empty;

    private async Task StartGame()
    {
        if (game == null)
        {
            message = "No game to start.";
            return;
        }

        GameResult result = game.Start();
        if (!result.Success)
        {
            message = $"Error starting game: {result.Error}";
            return;
        }

        await LoadMap();
    }

    private void JoinPlayer()
    {
        if (game == null || playerJoined) return;

        var result = game.Join(inputName, null);
        if (result.Success) 
        { 
            player = result.Player;
            playerJoined = true; 
        }
        else
        {
            message = result.Error.ToString()!;
        }
    }

    private string GenerateRandomColor(HashSet<string> usedColors)
    {
        Random random = new Random();

        string color;

        do
        {
            color = $"#{random.Next(0x1000000):X6}";
        }
        while (usedColors.Contains(color));

        return color;
    }

    void HostGame()
    {
        CreateGameResult result = gameRegistry.Create();

        if (!result.Success)
        {
            message = $"Error creating game: {result.Error}";
            return;
        }
        game = result.Game;
        hostedGame = true;
    }

    void JoinGame()
    {
        if (string.IsNullOrWhiteSpace(pinInput))
        {
            message = "Please enter a valid PIN.";
            return;
        }
        if (pinInput.Length < 4 || pinInput.Length > 8)
        {
            message = "PIN must contain 4 to 8 digits.";
            return;
        }

        Game? joinableGame = gameRegistry.Find(pinInput.ToString());
        if (joinableGame == null)
        {
            message = $"No game found with PIN {pinInput}.";
            return;
        }
        
        game = joinableGame;
        hostedGame = false;
    }

    void LeaveGame()
    {
        if (game == null) return;
        if (player != null)
        {
            //game.Leave(player);
        }

        if (hostedGame)
        {
            //gameRegistry.Remove(game.Pin);
        }

        playerJoined = false;
        player = null;
        game = null;
        hostedGame = false;
        message = "You have left the game.";
    }

    private async Task LoadMap()
    {
        if (gameDisplay == null || game == null || !game.Players.Any() || game.Board == null) return;
        
        await gameDisplay.LoadMap(game);
        
    }

    private async Task ToggleFullscreen()
    {
        await JS.InvokeVoidAsync(
            "gameFullscreen.toggle",
            gameContainer
        );
    }
}