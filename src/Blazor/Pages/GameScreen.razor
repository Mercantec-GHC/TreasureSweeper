@inject IJSRuntime JS
@using Domain.Games;
@using Blazor.Realtime;
@using Domain.Boards;
@inject GameRegistry gameRegistry
@inject GamePublisherRegistry publishers
@implements IDisposable

@page "/game-screen"

<PageTitle>Game Screen</PageTitle>

<div class="retro">

	<div @ref="gameContainer" class="@(game?.Board != null ? "game-layout" : "")">
		<section class="game-column lobby-column">
			@if (game == null)
			{
				<div class="initial-game">
					<h1>Game Screen</h1>
					<button class="btn btn-primary" disabled="@hostedGame" @onclick="HostGame">Host Game</button>
					<div class="join-game-group">
						<InputText @bind-Value="pinInput" placeholder="Enter game pin" />
						<button class="btn btn-primary" @onclick="JoinGame">Join Game</button>
					</div>
				</div>
			}
			else
			{
				<div class="lobby-game">
					<h1>Game Screen</h1>
					<h2>Lobby ID: @game.Pin</h2>
					<p>Players in Lobby:</p>
					<ul>
						@foreach (var p in game.Players)
						{
							<li style="color: @p.Color">
								@p.Name
							</li>
						}
					</ul>
					@if (game.Phase == GamePhase.Waiting)
					{
						<div class="join-game-group">
							<InputText @bind-Value="inputName" placeholder="Enter your name" />
							<button class="btn btn-primary" @onclick="() => JoinPlayer()">Join Lobby</button>
						</div>
						@if (hostedGame)
						{
							<button class="btn btn-primary" @onclick="StartGame">Start Game</button>
						}
					}
					<button class="btn btn-primary" @onclick="LeaveGame">Leave Game</button>
				</div>
			}

			@if (!string.IsNullOrEmpty(message))
			{
				<div class="alert alert-info" role="alert">
					@message
				</div>
			}
		</section>

		@if (game?.Board != null)
		{
			<section class="game-column board-column">
				<div class="game-container">

					<button class="btn btn-primary fullscreen-button"
							@onclick="ToggleFullscreen">
						⛶ Fullscreen
					</button>

					<GameDisplay @ref="gameDisplay" />
				</div>
			</section>

			<section class="game-column stats-column">
				<div class="stat-box">
					<h3>Time Left</h3>
					<div class="countdown">@RemainingTimeText</div>
				</div>

				<div class="stat-box">
					<h3>Treasures Left</h3>
					<div class="treasures">@(RemainingTreasures?.ToString() ?? "--")</div>
				</div>

				<div class="stat-box">
					<h3>Scoreboard</h3>
					<ol class="scoreboard">
						@foreach (var (p, score) in Scoreboard)
						{
							<li style="color: @p.Color">
								<span>@p.Name</span>
								<span class="score">@score</span>
							</li>
						}
					</ol>
				</div>
			</section>
		}

		@if (game?.Phase == GamePhase.Ended && !gameOverDismissed)
		{
			var ranking = Scoreboard.ToList();
			var winner = ranking.FirstOrDefault();
			<div class="game-over-overlay">
				<div class="game-over-panel">
					<div class="banner">
						<div class="game-over-title">Game Over</div>
						@if (game.EndReason == Shared.Games.RoundEndReason.AllTreasuresFound)
						{
							<div class="sub">All treasures found!</div>
							@if (winner.Player != null)
							{
								<div class="crown">👑</div>
								<div class="name" style="color: @winner.Player.Color">@winner.Player.Name</div>
								<div class="sub">wins with @winner.Score points</div>
							}
						}
						else
						{
							<div class="sub">Time's up!</div>
						}
					</div>

					<table>
						<thead>
							<tr>
								<th>#</th>
								<th>Player</th>
								<th class="num">Score</th>
								<th class="num">Treasures</th>
								<th class="num">Point mines</th>
								<th class="num">Freeze mines</th>
							</tr>
						</thead>
						<tbody>
							@for (var i = 0; i < ranking.Count; i++)
							{
								var (p, score) = ranking[i];
								var state = game.StateOf(p.Id);
								<tr class="@(i == 0 ? "winner-row" : "")">
									<td>@(i + 1)</td>
									<td style="color: @p.Color">@p.Name</td>
									<td class="num">@score</td>
									<td class="num">@(state?.TreasuresFound ?? 0)</td>
									<td class="num">@(state?.PointMinesHit ?? 0)</td>
									<td class="num">@(state?.FreezeMinesHit ?? 0)</td>
								</tr>
							}
						</tbody>
					</table>

					<div class="actions">
						<button class="btn btn-primary" @onclick="() => gameOverDismissed = true">Show Map</button>
						<button class="btn btn-primary" @onclick="LeaveGame">Leave Game</button>
					</div>
				</div>
			</div>
		}
	</div>
</div>

@code {
	private ElementReference gameContainer;
	private GameDisplay? gameDisplay;

	Game? game;
	Player? player;
	IDisposable? subscription;
	string pinInput = "0000";
	bool playerJoined = false;
	bool hostedGame = false;

	string inputName = string.Empty;

	string message = string.Empty;

	private System.Threading.Timer? uiTimer;
	private bool mapLoadPending;
	private bool gameOverDismissed;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (mapLoadPending && gameDisplay != null)
		{
			mapLoadPending = false;
			await LoadMap();
		}
	}

	private string RemainingTimeText
	{
		get
		{
			if (game?.EndsAt is not { } endsAt) return "--:--";
			if (game.Phase == GamePhase.Ended) return "00:00";
			var remaining = endsAt - DateTimeOffset.UtcNow;
			if (remaining < TimeSpan.Zero) remaining = TimeSpan.Zero;
			return remaining.ToString(@"mm\:ss");
		}
	}

	private int? RemainingTreasures
	{
		get
		{
			var board = game?.Board;
			if (board == null) return null;
			var count = 0;
			for (var x = 0; x < board.Size; x++)
				for (var y = 0; y < board.Size; y++)
				{
					var tile = board[new Position(x, y)];
					if (!tile.IsHole() && tile.HiddenContent() == TileContent.Treasure) count++;
				}
			return count;
		}
	}

	private IEnumerable<(Player Player, int Score)> Scoreboard =>
		game == null
			? []
			: game.Players
				.Select(p => (p, game.StateOf(p.Id)?.Score ?? 0))
				.OrderByDescending(x => x.Item2)
				.ToList();

	protected override void OnInitialized()
	{
		uiTimer = new System.Threading.Timer(_ =>
		{
			if (game?.Phase == GamePhase.Playing)
				InvokeAsync(StateHasChanged);
		}, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
	}

	private async Task StartGame()
	{
		if (game == null)
		{
			message = "No game to start.";
			return;
		}

		GameResult result = game.Start();
		if (!result.Success)
		{
			message = $"Error starting game: {result.Error}";
			return;
		}

		message = string.Empty;
		mapLoadPending = true;
		await LoadMap();
	}

	private void JoinPlayer()
	{
		if (game == null || playerJoined) return;

		var result = game.Join(inputName, null);
		if (result.Success)
		{
			player = result.Player;
			playerJoined = true;
			message = string.Empty;
		}
		else
		{
			message = result.Error.ToString()!;
		}
	}

	private string GenerateRandomColor(HashSet<string> usedColors)
	{
		Random random = new Random();

		string color;

		do
		{
			color = $"#{random.Next(0x1000000):X6}";
		}
		while (usedColors.Contains(color));

		return color;
	}

	void HostGame()
	{
		CreateGameResult result = gameRegistry.Create();

		if (!result.Success)
		{
			message = $"Error creating game: {result.Error}";
			return;
		}
		game = result.Game;
		SubscribeToGame();
		hostedGame = true;
		message = string.Empty;
	}

	void JoinGame()
	{
		if (string.IsNullOrWhiteSpace(pinInput))
		{
			message = "Please enter a valid PIN.";
			return;
		}
		if (pinInput.Length < 4 || pinInput.Length > 8)
		{
			message = "PIN must contain 4 to 8 digits.";
			return;
		}

		Game? joinableGame = gameRegistry.Find(pinInput.ToString());
		if (joinableGame == null)
		{
			message = $"No game found with PIN {pinInput}.";
			return;
		}

		game = joinableGame;
		SubscribeToGame();
		hostedGame = false;
		message = string.Empty;
	}

	void LeaveGame()
	{
		if (game == null) return;
		if (player != null)
		{
			//game.Leave(player);
		}

		if (hostedGame)
		{
			//gameRegistry.Remove(game.Pin);
		}

		playerJoined = false;
		player = null;
		Dispose();
		game = null;
		gameDisplay = null;
		hostedGame = false;
		message = "You have left the game.";
	}

	private async Task LoadMap()
	{
		if (gameDisplay == null || game == null || !game.Players.Any() || game.Board == null) return;
        
		await gameDisplay.LoadMap(game);
        
	}

	private async Task ToggleFullscreen()
	{
		await JS.InvokeVoidAsync(
			"gameFullscreen.toggle",
			gameContainer
		);
	}

	private async Task OnGameChanged()
	{
		if (gameDisplay == null) mapLoadPending = true;
		StateHasChanged();
		await LoadMap();
	}

	private void SubscribeToGame()
	{
		if (game == null) return;
		subscription?.Dispose();
		subscription = publishers.For(game).Subscribe(() => InvokeAsync(OnGameChanged));
	}

	public void Dispose()
	{
		subscription?.Dispose();
		subscription = null;
	}

	void IDisposable.Dispose()
	{
		Dispose();
		uiTimer?.Dispose();
		uiTimer = null;
	}
}
