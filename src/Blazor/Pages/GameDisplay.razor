@inject IJSRuntime JS
@using Domain.Games;
@using Domain.Boards;

<br>
<canvas @ref="gameCanvas"
        width="@(mapSize * tileSize)"
        height="@(mapSize * tileSize)"
        class="game-canvas">
</canvas>


@code {
    private ElementReference gameCanvas;
    int mapSize = 0;
    int tileSize = 32;

    public async Task LoadMap(Board map, IEnumerable<Player> players)
    {
        byte[][] tiles = new byte[map.Size][];

        for (int x = 0; x < map.Size; x++)
        {
            tiles[x] = new byte[map.Size];

            for (int y = 0; y < map.Size; y++)
            {
                Position position = new Position(x, y);

                Console.Write((byte)map[position] + " ");

                tiles[x][y] = (byte)map[position];
            }

            Console.WriteLine();
        }

        mapSize = map.Size;

        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        await JS.InvokeVoidAsync(
            "gameRenderer.drawMap",
            gameCanvas,
            tiles,
            players
        );
    }
}