@page "/"
@using Shared.Leaderboard
@using Infrastructure.Persistence
@inject ILeaderboardQueries Queries

<PageTitle>Leaderboard</PageTitle>

<h1>Leaderboard</h1>
<p>All-time top scores.</p>

<button class="btn btn-sm btn-outline-secondary mb-3" @onclick="Load">Refresh</button>

@if (error is not null)
{
    <div class="alert alert-warning">@error</div>
}
else if (entries is null)
{
    <p>Loading…</p>
}
else if (entries.Count == 0)
{
    <p class="text-muted">No rounds played yet.</p>
}
else
{
    <table class="table table-striped" style="max-width: 640px;">
        <thead>
            <tr><th>#</th><th>Player</th><th class="text-end">Score</th><th>When</th></tr>
        </thead>
        <tbody>
            @for (var i = 0; i < entries.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@entries[i].PlayerName</td>
                    <td class="text-end">@entries[i].Score</td>
                    <td>@entries[i].AchievedAt.LocalDateTime.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    IReadOnlyList<LeaderboardEntryResponse>? entries;
    string? error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            entries = await Queries.GetTopScoresAsync(10);
            error = null;
        }
        catch
        {
            error = "Leaderboard unavailable — is the database running?";
            entries = [];
        }
    }
}