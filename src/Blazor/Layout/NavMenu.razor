

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
	<nav class="nav flex-column">
		<a class="navbar-brand" href="">Treasure Sweeper</a>
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="" Match="NavLinkMatch.All">
				<span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
			</NavLink>
		</div>
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="game-screen" Match="NavLinkMatch.All">
				<span class="bi bi-controller-nav-menu" aria-hidden="true"></span> Game Screen
			</NavLink>
		</div>
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="leaderboard" Match="NavLinkMatch.All">
				<span class="bi bi-trophy-fill-nav-menu" aria-hidden="true"></span> Leaderboard
			</NavLink>
		</div>
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="monitor" Match="NavLinkMatch.All">
				<span class="bi bi-display-nav-menu" aria-hidden="true"></span> Monitor
			</NavLink>
		</div>
	</nav>
</div>

@code {
	private bool collapseNavMenu = true;

	private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

	private void ToggleNavMenu()
	{
		collapseNavMenu = !collapseNavMenu;
	}
}
